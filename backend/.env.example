# ============================================================
# TalentLedger — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your actual values.
# These can be loaded by docker-compose, systemd, or any
# env-file-aware process manager.
# ============================================================

# ── Database (PostgreSQL via PgBouncer) ──────────────────
DB_URL=jdbc:postgresql://localhost:5432/talentledger_dev?prepareThreshold=0
DB_USER=postgres
DB_PASS=postgres
FLYWAY_URL=jdbc:postgresql://localhost:5432/talentledger_dev
FLYWAY_USER=postgres
FLYWAY_PASS=postgres

# ── JWT / Auth ────────────────────────────────────────────
JWT_SECRET=<generate-a-256-bit-secret>
SESSION_TTL_HOURS=24

# ── Clerk OAuth ────────────────────────────────────────────
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_WEBHOOK_SECRET=<from-clerk-dashboard>
CLERK_ISSUER=https://your-instance.clerk.accounts.dev

# ── Feature Flags ─────────────────────────────────────────
FEATURE_NATIVE_AUTH=true
FEATURE_MFA=false

# ── Cloudflare R2 Storage ──────────────────────────────
R2_ACCOUNT_ID=<your-account-id>
R2_ACCESS_KEY=<your-access-key>
R2_SECRET_KEY=<your-secret-key>
R2_BUCKET=talentledger-uploads
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# ── AWS S3 Storage (alternative) ─────────────────────────
AWS_REGION=us-east-1
AWS_S3_BUCKET=talentledger-uploads
AWS_ACCESS_KEY=<your-access-key>
AWS_SECRET_KEY=<your-secret-key>

# ── Storage Provider ─────────────────────────────────────
STORAGE_PROVIDER=LOCAL  # Options: LOCAL | R2 | S3
LOCAL_STORAGE_PATH=./uploads

# ── Email (Resend) ────────────────────────────────────────
RESEND_API_KEY=<from-resend-dashboard>

# ── AI Enrichment ─────────────────────────────────────────
AI_PROVIDER=stub  # Options: stub | openai | claude
AI_OPENAI_API_KEY=<from-openai-dashboard>
AI_CLAUDE_API_KEY=<from-anthropic-dashboard>
AI_MODEL=gpt-4o

# ── CORS ───────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Server ────────────────────────────────────────────────
SERVER_PORT=8080
MAX_FILE_SIZE=50MB
MAX_REQUEST_SIZE=55MB
